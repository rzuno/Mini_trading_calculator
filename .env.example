# Toss Securities Open API credentials (Phase 1: market data, read-only).
# Copy this file to ".env" and fill in your values. NEVER commit the real .env
# (it is gitignored). Use KEY=VALUE, one per line.

TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# Optional overrides
TOSS_API_BASE=https://openapi.tossinvest.com

# Reserved for later phases (account read / orders) — not used in Phase 1:
# TOSS_ACCOUNT=
# TRADING_MODE=MANUAL
